{
  "name": "vk-pet/vk-client",
  "version": "0.1.0",
  "description": "Typed VK API client for messages, conversations and users",
  "type": "library",
  "license": "MIT",
  "require": {"php": ">=8.1", "ext-curl": "*", "ext-json": "*"},
  "require-dev": {"phpunit/phpunit": "^10.5", "squizlabs/php_codesniffer": "^3.13"},
  "autoload": {"psr-4": {"VkPet\\": "src/"}},
  "autoload-dev": {"psr-4": {"VkPet\\Tests\\": "tests/"}},
  "scripts": {
    "test": "phpunit",
    "check": "phpcs --standard=PSR12 src tests examples",
    "coverage": "phpunit --coverage-text"
  }
}
